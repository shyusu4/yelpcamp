<% layout('layouts/boilerplate') %>
<div class="container d-flex justify-content-center align-items-center vh-100">
  <div class="col-lg-6">
    <h2 class="fw-bold mb-4">Edit Campground</h2>
    <form
      action="/campgrounds/<%=campground._id%>?_method=PUT"
      method="POST"
      novalidate
      class="validated-form"
    >
      <div class="mb-3">
        <label for="title" class="form-label" style="font-weight: 500"
          >Campground Name</label
        >
        <input
          type="text"
          id="title"
          name="campground[title]"
          value="<%=campground.title %>"
          class="form-control bg-light border-0 input-height"
          required
        />
      </div>
      <div class="mb-3">
        <label for="price" class="form-label" style="font-weight: 500"
          >Price (in USD)</label
        >
        <input
          type="text"
          id="price"
          name="campground[price]"
          value="<%=campground.price %>"
          class="form-control bg-light border-0 input-height"
          required
        />
      </div>
      <div class="mb-3">
        <label for="image" class="form-label" style="font-weight: 500"
          >Image</label
        >
        <input
          type="text"
          id="image"
          name="campground[image]"
          value="<%=campground.image %>"
          class="form-control bg-light border-0 input-height"
          required
        />
      </div>
      <div class="mb-3">
        <label for="description" class="form-label" style="font-weight: 500"
          >Description</label
        >
        <textarea
          id="description"
          name="campground[description]"
          class="form-control bg-light border-0 no-resize"
          rows="8"
          required
        >
<%=campground.description %></textarea
        >
      </div>
      <button type="submit" class="btn btn-dark w-100 py-3 mt-3">
        Update Campground
      </button>
    </form>
  </div>
</div>
<style>
  .input-height {
    height: 55px;
  }
  .no-resize {
    resize: none;
  }
</style>
