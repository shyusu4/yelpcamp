<% layout('layouts/boilerplate') %>
<div class="row justify-content-md-center">
  <% for (let i = 0; i < campgrounds.length; i++) { %>
  <div class="col-lg-4 col-md-6 col-sm-6">
    <div class="card my-3 mx-1">
      <img
        class="card-img-top mx-3 mt-3 rounded w-auto"
        src="<%= campgrounds[i].image %>"
        alt=""
      />
      <div class="card-body">
        <h5 class="card-title fw-bold"><%= campgrounds[i].title %></h5>
        <p class="card-text text-secondary">
          <%= campgrounds[i].description.substring(0, 80) %>...
        </p>
        <a
          href="/campgrounds/<%= campgrounds[i]._id %>"
          class="border border-dark-subtle rounded px-4 py-3 text-decoration-none text-dark fw-bold fs-5 d-block text-center"
          >View Campground</a
        >
      </div>
    </div>
  </div>
  <% } %>
</div>
