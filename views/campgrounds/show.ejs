<% layout('layouts/boilerplate') %>
<div class="row justify-content-md-center">
  <div class="col-3">
    <div class="card my-3 mx-1 p-4">
      <img
        class="card-img-top mx-3 mt-3 rounded w-auto"
        src="https://developers.google.com/static/maps/documentation/android-sdk/images/zoom-level-14.png"
        alt=""
      />
      <div class="card-body">
        <p class="card-text text-secondary fst-italic">
          <%= campground.location %>
        </p>
      </div>
    </div>
  </div>

  <div class="col-md-7">
    <div class="card my-3 mx-1 p-4">
      <img
        class="card-img-top mx-3 mt-3 rounded w-auto"
        src="<%= campground.image %>"
        alt=""
      />
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <h5 class="card-title fw-bold"><%= campground.title %></h5>
          </div>
          <div class="col-md-6 text-end">
            <p class="fw-bold">$<%= campground.price %>/night</p>
          </div>
        </div>
        <p class="card-text text-secondary"><%= campground.description %></p>
      </div>
    </div>
  </div>
</div>

<div class="row justify-content-md-center">
  <div class="col-3"></div>

  <div class="col-md-7">
    <div class="card my-3 mx-1 p-4">
      <div class="card-body">
        <div class="pb-4 border-bottom">
          <div class="row">
            <div class="col-md-6">
              <p class="card-text fw-bold">Adam Jones</p>
            </div>
            <div class="col-md-6 text-end">
              <p class="text-secondary">13h ago</p>
            </div>
          </div>
          <p class="card-text text-secondary">
            Honestly one of the best experiences ever, took us a while to figure
            out how to get there but it was amazing!
          </p>
        </div>
        <div class="pt-4 pb-4 border-bottom">
          <div class="row">
            <div class="col-md-6">
              <p class="card-text fw-bold">Isaac Dylan</p>
            </div>
            <div class="col-md-6 text-end">
              <p class="text-secondary">1 day ago</p>
            </div>
          </div>
          <p class="card-text text-secondary">
            Traveling with my family was a blast, we had a great time and the
            kids loved it!
          </p>
        </div>
        <input
          type="button"
          onclick="location.href='/campgrounds/<%= campground._id %>/review';"
          value="Leave a Review"
          class="btn btn-dark py-3 mt-3 text-end"
        />
      </div>
    </div>
  </div>
</div>
