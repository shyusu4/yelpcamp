<% layout('layouts/boilerplate') %>
<div class="row justify-content-md-center">
  <div class="col-3">
    <div class="card my-3 mx-1 p-4">
      <div class="card-body">
        <div id="map" style="width: 100%; height: 300px"></div>
        <p class="card-text text-secondary fst-italic">
          <%= campground.location %>
        </p>
      </div>
    </div>
  </div>
  <div class="col-md-7">
    <div class="card my-3 mx-1 p-4">
      <img
        class="card-img-top mx-3 mt-3 rounded w-auto"
        src="<%= campground.image %>"
        alt=""
      />
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <h5 class="card-title fw-bold"><%= campground.title %></h5>
          </div>
          <div class="col-md-6 text-end">
            <p class="fw-bold">$<%= campground.price %>/night</p>
          </div>
        </div>
        <p class="card-text text-secondary"><%= campground.description %></p>
      </div>
    </div>
  </div>
</div>

<div class="row justify-content-md-center">
  <div class="col-3"></div>

  <div class="col-md-7">
    <div class="card my-3 mx-1 p-4">
      <div class="card-body">
        <% for(let review of campground.reviews) { %>
        <div class="pb-4 border-bottom">
          <div class="row">
            <div class="col-md-6">
              <p class="card-text fw-bold"><%= review.author.username %></p>
            </div>
            <div class="col-md-6 text-end">
              <p class="text-secondary">13h ago</p>
            </div>
          </div>
          <p class="card-text text-secondary"><%= review.body %></p>
          <% if(currentUser && review.author.equals(currentUser._id)) { %>
          <div class="d-flex justify-content-end">
            <form
              action="/campgrounds/<%= campground._id %>/review/<%= review._id %>?_method=DELETE"
              method="POST"
              class="d-inline"
            >
              <button type="submit" class="btn btn-sm btn-danger">
                Delete
              </button>
            </form>
          </div>
          <% } %>
        </div>
        <% } %> <% if(currentUser) { %>
        <input
          type="button"
          onclick="location.href='/campgrounds/<%= campground._id %>/review';"
          value="Leave a Review"
          class="btn btn-dark py-3 mt-3 text-end"
        />
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  const mapToken = "<%- process.env.MAPBOX_TOKEN  %>";
  const campground = <%- JSON.stringify(campground) %>;
</script>
<script src="/scripts/showPageMap.js"></script>
