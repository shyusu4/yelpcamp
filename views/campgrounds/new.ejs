<% layout('layouts/boilerplate') %>
<div class="container d-flex justify-content-center align-items-center vh-100">
  <div class="col-lg-6">
    <h2 class="fw-bold mb-4">Add New Campground</h2>
    <form action="/campgrounds" method="POST" novalidate class="validated-form">
      <div class="mb-3">
        <label for="title" class="form-label" style="font-weight: 500"
          >Campground Name</label
        >
        <input
          type="text"
          id="title"
          name="campground[title]"
          placeholder="Seven Sisters Waterfall"
          class="form-control bg-light border-0 input-height"
          required
        />
      </div>
      <div class="mb-3">
        <label for="price" class="form-label" style="font-weight: 500"
          >Price</label
        >
        <input
          type="text"
          id="price"
          name="campground[price]"
          placeholder="$149.99"
          class="form-control bg-light border-0 input-height"
          required
        />
      </div>
      <div class="mb-3">
        <label for="image" class="form-label" style="font-weight: 500"
          >Image</label
        >
        <input
          type="text"
          id="image"
          name="campground[image]"
          placeholder="https://images.unsplash.com/photo-1627300008477-4b7b0b0b0b0b"
          class="form-control bg-light border-0 input-height"
          required
        />
      </div>
      <div class="mb-3">
        <label for="description" class="form-label" style="font-weight: 500"
          >Description</label
        >
        <textarea
          id="description"
          name="campground[description]"
          placeholder="The Seven Sisters Waterfall is the 39th tallest waterfall in Norway. The waterfall consists of seven separate streams, and the tallest of the seven has a free fall that measures 250 metres (820 ft)."
          class="form-control bg-light border-0 no-resize"
          rows="8"
          required
        ></textarea>
      </div>
      <button type="submit" class="btn btn-dark w-100 py-3 mt-3">
        Add Campground
      </button>
    </form>
  </div>
</div>
<style>
  .input-height {
    height: 55px;
  }
  .no-resize {
    resize: none;
  }
</style>
