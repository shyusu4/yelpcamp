<% layout('layouts/boilerplate')%>
<form action="/signup" method="POST" class="validated-form" novalidate>
  <div class="mb-3">
    <label class="form-label" for="username" style="font-weight: 500"
      >Username</label
    >
    <input
      class="form-control"
      type="text"
      id="username"
      name="username"
      class="form-control bg-light border-0 input-height"
      required
    />
  </div>
  <div class="mb-3">
    <label class="form-label" for="email" style="font-weight: 500">Email</label>
    <input
      class="form-control"
      type="email"
      id="email"
      name="email"
      class="form-control bg-light border-0 input-height"
      required
    />
  </div>
  <div class="mb-3">
    <label class="form-label" for="password" style="font-weight: 500"
      >Password</label
    >
    <input
      class="form-control"
      type="password"
      id="password"
      name="password"
      class="form-control bg-light border-0 input-height"
      required
    />
  </div>
  <button type="submit" class="btn btn-dark w-100 py-3 mt-3">Sign Up</button>
</form>
